{
  "id": "health-cards",
  "contexts": ["household", "shared_space"],
  "name": "Health Cards",
  "version": "1.0.1",
  "description": "Allergy and emergency health information for every family member. Generate a printable card to share with parents, caregivers, or schools.",
  "entrypoint": "index.html",
  "runtime": "static",
  "icon": "\ud83c\udfe5",
  "category": "general",
  "tags": [
    "health",
    "allergies",
    "emergency",
    "medical",
    "kids"
  ],
  "storage": "db",
  "db_plaintext_columns": ["priority", "visibility"],
  "preload": {
    "health_profiles": {"sql": "SELECT * FROM app_health_cards__health_profiles ORDER BY created_at"},
    "health_allergies": {"sql": "SELECT * FROM app_health_cards__health_allergies ORDER BY profile_id, sort_order, created_at"},
    "health_medications": {"sql": "SELECT * FROM app_health_cards__health_medications ORDER BY profile_id, created_at"},
    "health_contacts": {"sql": "SELECT * FROM app_health_cards__health_contacts ORDER BY profile_id, priority, created_at"},
    "settings": {"sql": "SELECT key, value FROM app_health_cards__settings WHERE key = 'care_team_group_id'"}
  },
  "data_access": {
    "reads": [
      "family.members",
      "family.groups"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "adults",
    "requires_approval": false
  },
  "row_policies": {
    "health_profiles": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": [],
      "adult_values": ["adults", "care"],
      "privileged_values": ["care"],
      "privileged_groups": [
        { "settings_table": "settings", "settings_key": "care_team_group_id", "actions": ["select"] }
      ],
      "supervisor_assigns_owner": true,
      "coparenting_child_supervision": true,
      "delete_adult_only": true,
      "audit_writes": true,
      "column_write_acls": {
        "id": { "writable_by": [], "actions": ["update"] },
        "member_id": { "writable_by": [], "actions": ["update"] },
        "notes": { "writable_by": ["adult"] },
        "card_name": { "writable_by": ["adult"] },
        "visibility": { "writable_by": ["adult"] },
        "created_at": { "writable_by": ["adult"] },
        "updated_at": { "writable_by": ["adult"] }
      }
    },
    "health_allergies": {
      "kind": "inherit_visibility",
      "fk_column": "profile_id",
      "parent_table": "health_profiles",
      "writer_column": "created_by",
      "adults_bypass": true,
      "coparenting_child_supervision": true,
      "delete_adult_only": true,
      "audit_writes": true,
      "column_write_acls": {
        "id": { "writable_by": ["adult"] },
        "profile_id": { "writable_by": ["adult"] },
        "name": { "writable_by": ["adult"] },
        "severity": { "writable_by": ["adult"] },
        "triggers": { "writable_by": ["adult"] },
        "symptoms": { "writable_by": ["adult"] },
        "response_steps": { "writable_by": ["adult"] },
        "sort_order": { "writable_by": ["adult"] },
        "created_at": { "writable_by": ["adult"] },
        "created_by": { "writable_by": [], "actions": ["update"] }
      }
    },
    "health_medications": {
      "kind": "inherit_visibility",
      "fk_column": "profile_id",
      "parent_table": "health_profiles",
      "writer_column": "created_by",
      "adults_bypass": true,
      "coparenting_child_supervision": true,
      "delete_adult_only": true,
      "audit_writes": true,
      "column_write_acls": {
        "id": { "writable_by": ["adult"] },
        "profile_id": { "writable_by": ["adult"] },
        "name": { "writable_by": ["adult"] },
        "dose": { "writable_by": ["adult"] },
        "when_to_give": { "writable_by": ["adult"] },
        "location": { "writable_by": ["adult"] },
        "notes": { "writable_by": ["adult"] },
        "created_at": { "writable_by": ["adult"] },
        "created_by": { "writable_by": [], "actions": ["update"] }
      }
    },
    "health_contacts": {
      "kind": "inherit_visibility",
      "fk_column": "profile_id",
      "parent_table": "health_profiles",
      "writer_column": "created_by",
      "adults_bypass": true,
      "coparenting_child_supervision": true,
      "delete_adult_only": true,
      "audit_writes": true,
      "column_write_acls": {
        "id": { "writable_by": ["adult"] },
        "profile_id": { "writable_by": ["adult"] },
        "name": { "writable_by": ["adult"] },
        "relationship": { "writable_by": ["adult"] },
        "phone": { "writable_by": ["adult"] },
        "priority": { "writable_by": ["adult"] },
        "created_at": { "writable_by": ["adult"] },
        "created_by": { "writable_by": [], "actions": ["update"] }
      }
    },
    "settings": { "kind": "app_config" }
  },
  "admin_config": { "settings_table": "settings", "keys": ["care_team_group_id"] },
  "delete_cascades": {
    "health_profiles": [
      { "table": "health_allergies", "foreign_key": "profile_id" },
      { "table": "health_medications", "foreign_key": "profile_id" },
      { "table": "health_contacts", "foreign_key": "profile_id" }
    ]
  },
  "member_references": {
    "health_profiles": {
      "column": "member_id",
      "on_removed": "delete",
      "dependent_tables": [
        {
          "table": "health_allergies",
          "foreign_key": "profile_id"
        },
        {
          "table": "health_medications",
          "foreign_key": "profile_id"
        },
        {
          "table": "health_contacts",
          "foreign_key": "profile_id"
        }
      ]
    },
    "health_allergies": { "column": "created_by", "on_removed": "keep" },
    "health_medications": { "column": "created_by", "on_removed": "keep" },
    "health_contacts": { "column": "created_by", "on_removed": "keep" }
  },
  "shareable": {
    "card": {
      "table": "health_profiles",
      "title_column": "card_name",
      "columns": [],
      "mint_roles": "admin",
      "feeds": [
        {
          "label": "Allergies",
          "table": "health_allergies",
          "fk_column": "profile_id",
          "columns": [
            { "column": "name", "label": "Allergy", "role": "heading" },
            {
              "column": "severity", "label": "Severity", "role": "detail",
              "value_labels": { "mild": "Mild", "moderate": "Moderate", "severe": "Severe", "anaphylactic": "Anaphylactic" }
            },
            { "column": "triggers", "label": "Triggers", "role": "detail" },
            { "column": "symptoms", "label": "Symptoms", "format": "multiline", "role": "body" },
            { "column": "response_steps", "label": "What to do", "format": "multiline", "role": "body" }
          ],
          "order_column": "sort_order",
          "order": "oldest",
          "max_items": 50,
          "empty_text": "No allergies recorded."
        },
        {
          "label": "Medications",
          "table": "health_medications",
          "fk_column": "profile_id",
          "columns": [
            { "column": "name", "label": "Medication", "role": "heading" },
            { "column": "dose", "label": "Dose", "role": "detail" },
            { "column": "location", "label": "Kept", "role": "detail" },
            { "column": "when_to_give", "label": "When to give", "format": "multiline", "role": "body" },
            { "column": "notes", "label": "Notes", "format": "multiline", "role": "body" }
          ],
          "order_column": "created_at",
          "order": "oldest",
          "max_items": 50,
          "empty_text": "No medications recorded."
        },
        {
          "label": "Emergency contacts",
          "table": "health_contacts",
          "fk_column": "profile_id",
          "columns": [
            { "column": "name", "label": "Name", "role": "heading" },
            { "column": "relationship", "label": "Relationship", "role": "detail" },
            { "column": "phone", "label": "Phone", "format": "tel", "role": "detail" }
          ],
          "order_column": "priority",
          "order": "oldest",
          "max_items": 20,
          "empty_text": "No emergency contacts recorded."
        }
      ]
    }
  },
  "nav": {
    "label": "Health Cards"
  }
}
